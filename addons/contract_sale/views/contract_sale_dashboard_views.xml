<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Contract Sale Dashboard Kanban View -->
    <record id="view_contract_sale_dashboard_kanban" model="ir.ui.view">
        <field name="name">contract.sale.dashboard.kanban</field>
        <field name="model">contract.sale</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_contract_kanban">
                <field name="name"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="qty_sold"/>
                <field name="qty_remaining"/>
                <field name="progress_percentage"/>
                <field name="sale_order_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <strong><t t-esc="record.name.value"/></strong>
                                    <div><t t-esc="record.partner_id.value"/></div>
                                </div>
                                <div class="o_kanban_card_header_status">
                                    <span class="badge" t-attf-class="badge {{ record.state.raw_value == 'active' ? 'text-bg-success' : (record.state.raw_value == 'draft' ? 'text-bg-secondary' : (record.state.raw_value == 'expired' ? 'text-bg-warning' : 'text-bg-info')) }}">
                                        <t t-esc="record.state.value"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="row mt-3">
                                    <div class="col-6">
                                        <div class="o_stat_value">
                                            <t t-esc="record.qty_sold.value"/>
                                        </div>
                                        <div class="o_stat_info">Đã bán</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="o_stat_value">
                                            <t t-esc="record.qty_remaining.value"/>
                                        </div>
                                        <div class="o_stat_info">Còn lại</div>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="progress">
                                            <div class="progress-bar" role="progressbar"
                                                 t-attf-style="width: {{ Math.min(record.progress_percentage.raw_value, 100) }}%;"
                                                 t-attf-class="progress-bar {{ record.progress_percentage.raw_value >= 100 ? 'bg-danger' : (record.progress_percentage.raw_value >= 80 ? 'bg-warning' : 'bg-success') }}">
                                                <t t-esc="Math.round(record.progress_percentage.raw_value)"/>%
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="oe_kanban_list_many2many">
                                            <t t-esc="record.sale_order_count.value"/> đơn
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Contract Sale Dashboard Action -->
    <record id="action_contract_sale_dashboard" model="ir.actions.act_window">
        <field name="name">Bảng điều khiển</field>
        <field name="res_model">contract.sale</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_contract_sale_dashboard_kanban"/>
        <field name="domain">[('state', 'in', ['active', 'expired'])]</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Dashboard Menu -->
    <menuitem id="menu_contract_sale_dashboard" name="Bảng điều khiển"
              parent="menu_contract_sale_root" action="action_contract_sale_dashboard"
              sequence="0" groups="group_contract_director"/>

    <!-- Dashboard Stat Action: Active Contracts -->
    <record id="action_contract_sale_active" model="ir.actions.act_window">
        <field name="name">Hợp đồng đang hoạt động</field>
        <field name="res_model">contract.sale</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'active')]</field>
    </record>

    <!-- Dashboard Stat Action: Running SOs -->
    <record id="action_sale_order_running" model="ir.actions.act_window">
        <field name="name">Đơn bán hàng đang chạy</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_id', '!=', False), ('state', 'in', ['sale', 'done'])]</field>
    </record>

    <!-- Dashboard Stat Action: Pending POs -->
    <record id="action_purchase_order_pending" model="ir.actions.act_window">
        <field name="name">Đơn mua hàng chờ xử lý</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_order_id', '!=', False), ('state', 'in', ['draft', 'sent'])]</field>
    </record>
</odoo>

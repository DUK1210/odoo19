<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Contract Sale -->
        <record id="seq_contract_sale" model="ir.sequence">
            <field name="name">Hợp đồng bán hàng</field>
            <field name="code">contract.sale</field>
            <field name="prefix">CTR/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cron Job: Check Expired Contracts -->
        <record id="ir_cron_check_expired_contracts" model="ir.cron">
            <field name="name">Hợp đồng bán: Kiểm tra hợp đồng hết hạn</field>
            <field name="model_id" ref="model_contract_sale"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job: Send Alerts -->
        <record id="ir_cron_send_contract_alerts" model="ir.cron">
            <field name="name">Hợp đồng bán: Gửi cảnh báo số lượng và hết hạn</field>
            <field name="model_id" ref="model_contract_sale"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Create PO from SO Wizard Form View -->
    <record id="view_create_po_from_so_wizard_form" model="ir.ui.view">
        <field name="name">create.po.from.so.wizard.form</field>
        <field name="model">create.po.from.so.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo đơn mua hàng">
                <sheet>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="partner_id" context="{'search_default_suppliers': 1}"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sale_order_line_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="qty_available" readonly="1"/>
                            <field name="qty_to_purchase"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_purchase_order" string="Tạo đơn mua hàng"
                            type="object" class="oe_highlight"/>
                    <button name="action_cancel" string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

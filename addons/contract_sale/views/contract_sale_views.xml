<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Contract Sale Form View -->
    <record id="view_contract_sale_form" model="ir.ui.view">
        <field name="name">contract.sale.form</field>
        <field name="model">contract.sale</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng bán hàng">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Hoàn thành" type="object"
                            invisible="state not in ['active', 'expired']"/>
                    <button name="action_draft" string="Hoàn về nháp" type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders" type="object" icon="fa-shopping-cart"
                                class="oe_stat_button" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Đơn bán hàng"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one"
                                   options="{'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount" widget="monetary"/>
                            <field name="progress_percentage" widget="progressbar"
                                   options="{'current_value': 'progress_percentage', 'max_value': 100, 'editable': false}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết hợp đồng">
                            <field name="line_ids" readonly="state == 'active'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty_contract"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="qty_sold"/>
                                    <field name="qty_remaining"/>
                                    <field name="progress_percentage" widget="progressbar"
                                           options="{'max_value': 100}"/>
                                    <field name="subtotal" sum="Tổng"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="qty_contract"/>
                                        <field name="uom_id"/>
                                        <field name="price_unit"/>
                                        <field name="qty_sold" readonly="1"/>
                                        <field name="qty_remaining" readonly="1"/>
                                        <field name="qty_purchased" readonly="1"/>
                                        <field name="qty_received" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Đơn bán hàng">
                            <field name="sale_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Theo dõi">
                            <group>
                                <group string="Tổng số lượng">
                                    <field name="qty_sold"/>
                                    <field name="qty_remaining"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
<!--                <div class="oe_chatter">-->
<!--                    <field name="message_follower_ids" widget="mail_followers"/>-->
<!--                    <field name="activity_ids" widget="mail_activity"/>-->
<!--                    <field name="message_ids" widget="mail_thread"/>-->
<!--                </div>-->
            </form>
        </field>
    </record>

    <!-- Contract Sale List View -->
    <record id="view_contract_sale_list" model="ir.ui.view">
        <field name="name">contract.sale.list</field>
        <field name="model">contract.sale</field>
        <field name="arch" type="xml">
            <list string="Hợp đồng">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="total_amount" sum="Tổng"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="qty_sold"/>
                <field name="qty_remaining"/>
            </list>
        </field>
    </record>


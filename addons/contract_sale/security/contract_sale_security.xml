<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Contract Sale Manager Group -->
        <record id="group_contract_sale_manager" model="res.groups">
            <field name="name">Quản lý hợp đồng bán</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <!-- Contract Sale User Group -->
        <record id="group_contract_sale_user" model="res.groups">
            <field name="name">Nhân viên hợp đồng bán</field>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- Purchase Manager for Contract -->
        <record id="group_contract_purchase_manager" model="res.groups">
            <field name="name">Quản lý mua hàng hợp đồng</field>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        </record>

        <!-- Warehouse Staff for Contract -->
        <record id="group_contract_warehouse_user" model="res.groups">
            <field name="name">Nhân viên kho hợp đồng</field>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <!-- Director Dashboard Access -->
        <record id="group_contract_director" model="res.groups">
            <field name="name">Giám đốc hợp đồng</field>
            <field name="implied_ids" eval="[(4, ref('group_contract_sale_manager')), (4, ref('group_contract_purchase_manager'))]"/>
        </record>

        <!-- Record Rules -->
        <!-- Contract Sale: User sees own contracts, Manager sees all -->
        <record id="rule_contract_sale_user" model="ir.rule">
            <field name="name">Hợp đồng bán: Người dùng</field>
            <field name="model_id" ref="model_contract_sale"/>
            <field name="groups" eval="[(4, ref('group_contract_sale_user'))]"/>
            <field name="domain_force">
                ['|', ('create_uid', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id])]
            </field>
        </record>

        <record id="rule_contract_sale_manager" model="ir.rule">
            <field name="name">Hợp đồng bán: Quản lý</field>
            <field name="model_id" ref="model_contract_sale"/>
            <field name="groups" eval="[(4, ref('group_contract_sale_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Multi-company rule -->
        <record id="rule_contract_sale_multi_company" model="ir.rule">
            <field name="name">Hợp đồng bán: Đa công ty</field>
            <field name="model_id" ref="model_contract_sale"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_contract_sale_line_multi_company" model="ir.rule">
            <field name="name">Chi tiết hợp đồng: Đa công ty</field>
            <field name="model_id" ref="model_contract_sale_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
